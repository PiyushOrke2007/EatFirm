# Node Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=eatfirm_dev
DB_USER=eatfirm
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Security & CORS
CORS_ORIGIN=*
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long

# Log Level: error | warn | info | http | debug
LOG_LEVEL=info

